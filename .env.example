APP_ENV=development
APP_NAME=economic-cycle-monitor
LOG_LEVEL=INFO

POSTGRES_DB=macro
POSTGRES_USER=macro
POSTGRES_PASSWORD=macro
DATABASE_URL=postgresql+psycopg://macro:macro@localhost:5432/macro
TEST_DATABASE_URL=postgresql+psycopg://macro:macro@localhost:5432/macro_test

LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=
DEEPSEEK_API_KEY=
LLM_MODE=mock

FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred
FRED_TIMEOUT_SECONDS=30
FRED_MAX_RETRIES=3
FRED_RETRY_BASE_SECONDS=1
FRED_CACHE_ENABLED=true
FRED_CACHE_TTL_SECONDS=3600
FRED_DEFAULT_BACKFILL_START=2000-01-01
FRED_WEEKLY_LOOKBACK_DAYS=90
FRED_MONTHLY_LOOKBACK_MONTHS=18
FRED_QUARTERLY_LOOKBACK_QUARTERS=12
DATABASE_BATCH_SIZE=1000
RAW_DATA_DIR=data/raw
CACHE_DIR=data/cache
OUTPUT_DIR=outputs
BEA_API_KEY=
BLS_API_KEY=
CENSUS_API_KEY=

FETCH_CONCURRENCY=4
PER_SOURCE_FETCH_CONCURRENCY=2
ANALYSIS_CONCURRENCY=1
LLM_CONCURRENCY=1
BACKTEST_CONCURRENCY=1

SCHEDULER_ENABLED=false
